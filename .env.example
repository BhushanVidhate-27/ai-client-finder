# Google Places API key (required for lead discovery)
GOOGLE_MAPS_API_KEY=

# Gemini API key (required for qualification, research, and website generation)
GEMINI_API_KEY=

# Single-admin authentication (required; the app fails closed if unset)
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=

# Optional: override the SQLite database path relative to the repo root
# DATABASE_PATH=data/app.sqlite

# Hosting provider credentials (Step 13 — used server-side only, never exposed)
# Vercel Personal Access Token
# VERCEL_TOKEN=
# Netlify API access token (+ optional default site ID)
# NETLIFY_TOKEN=
# NETLIFY_SITE_ID=
# Cloudflare API token + account ID
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Set to "1" or "true" to register the mock hosting provider (dev/test only)
# MOCK_DEPLOYMENTS=1

# Transport safety (Agent 10 / Step 17) — read only; nothing sends email yet.
# EMAIL_TRANSPORT_CONFIGURED=1
# EMAIL_TRANSPORT_PROVIDER=